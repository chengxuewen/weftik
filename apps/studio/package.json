{
  "private": true,
  "name": "weftik-studio",
  "productName": "Weftik Studio",
  "version": "0.1.0",
  "description": "Weftik Studio IDE — Industrial Control Development Environment based on Eclipse Theia",
  "main": "lib/backend/electron-main.js",
  "license": "Apache-2.0",
  "theia": {
    "target": "browser",
    "frontend": {
      "config": {
        "applicationName": "Weftik Studio",
        "defaultTheme": "dark"
      }
    },
    "backend": {
      "config": {
        "plugin": {
          "autoDownload": false,
          "marketplace": []
        }
      }
    }
  },
  "dependencies": {
    "@theia/console": "1.73.0",
    "@theia/core": "1.73.0",
    "@theia/debug": "1.73.0",
    "@theia/editor": "1.73.0",
    "@theia/electron": "1.73.0",
    "@theia/filesystem": "1.73.0",
    "@theia/markers": "1.73.0",
    "@theia/messages": "1.73.0",
    "@theia/monaco": "1.73.0",
    "@theia/navigator": "1.73.0",
    "@theia/output": "1.73.0",
    "@theia/preferences": "1.73.0",
    "@theia/process": "1.73.0",
    "@theia/task": "1.73.0",
    "@theia/terminal": "1.73.0",
    "@theia/test": "1.73.0",
    "@theia/workspace": "1.73.0",
    "weftik-backend": "0.1.0",
    "weftik-core": "0.1.0",
    "weftik-debug": "0.1.0",
    "weftik-gcode-editor": "0.1.0",
    "weftik-il-editor": "0.1.0",
    "weftik-ld-editor": "0.1.0",
    "weftik-fbd-editor": "0.1.0",
    "weftik-st-editor": "0.1.0",
    "@weftik/theia-bridge": "file:../../crates/weftik-theia-bridge"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@theia/cli": "1.73.0",
    "electron": "39.8.7"
  },
  "scripts": {
    "start": "theia start --plugins=local-dir:empty",
    "start:dev": "npx electron lib/backend/electron-main.js --no-cluster",
    "build": "theia build --mode production && bash check-gates.sh",
    "clean": "theia clean",
    "postinstall": "echo skip",
    "check:symbols": "for s in OpenHandler FrontendApplicationContribution OpenerService WidgetFactory; do count=$(grep -c \"Symbol(\\\"$s\\\")\" lib/frontend/bundle.js); [ \"$count\" = \"1\" ] || (echo FAIL: $s=$count && exit 1); done && echo OK",
    "check:gates": "bash check-gates.sh"
  }
}